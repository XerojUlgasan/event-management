# Local PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="event_management"
DB_USER="event_management"
DB_PASSWORD="event_management"

# API
API_PORT=3000
WEB_ORIGIN="http://localhost:4321"
SESSION_TTL_DAYS=7
# Set in production to enable secure session cookies.
# NODE_ENV=production

# Firebase Admin service-account JSON from the Firebase console
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Supabase Storage for the Node API and worker
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="event-management"
# Edge can use its injected credentials. The API also accepts SUPABASE_SECRET_KEY or SUPABASE_SECRET_KEYS.

# Realtime signing for local Supabase
REALTIME_JWT_SECRET=""
# For hosted Supabase, use its trusted private ES256 signing JWK with a kid.
# REALTIME_JWT_SIGNING_JWK=

# AI Gateway
AI_GATEWAY_API_KEY=""
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
VISION_MODEL=deepseek/deepseek-v4.1-flash-1017
EMBEDDING_MODEL=google/gemini-embedding-2

# Scenario and admin seed commands
SEED_RANDOM_SEED=clemora-scenario-v1
# SEED_CLOCK=2026-11-16T00:00:00Z
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
