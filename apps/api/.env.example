DB_HOST="localhost"
DB_PORT=5432
DB_NAME="event_management"
DB_USER="event_management"
DB_PASSWORD="event_management"
API_PORT=3000
WEB_ORIGIN="http://localhost:4321"
SESSION_TTL_DAYS=7

# Google AI / Gemini (server-side only)
# Create a key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override the default model if you have a different Google AI model available.
GEMINI_MODEL="gemini-3.6-flash"
# Some setups use GOOGLE_API_KEY instead of GEMINI_API_KEY; both are accepted.
# GOOGLE_API_KEY=""


# Firebase Admin credentials (Firebase console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or point at the downloaded service-account JSON instead of the three values above.
# Place the file in apps/api/.secrets/ (gitignored) and use a path relative to apps/api:
# GOOGLE_APPLICATION_CREDENTIALS=".secrets/firebase-service-account.json"
