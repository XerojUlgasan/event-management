# Local PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="event_management"
DB_USER="event_management"
DB_PASSWORD="event_management"

# API
API_PORT=3000
WEB_ORIGIN="http://localhost:4321"
SESSION_TTL_DAYS=7
# Set in production to enable secure session cookies.
# NODE_ENV=production

# Firebase Admin service-account JSON from the Firebase console
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Private Cloudflare R2 bucket and S3 API credentials
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional separate bucket for PDFs; otherwise PDFs use supporting-documents/ in R2_BUCKET_NAME.
# R2_DOCUMENTS_BUCKET_NAME=""
# R2_REGION=auto

# Use one private ES256 JWK for the target project, as an object or a one-key array.
# SUP_JWT_KEY='[{"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}]'

# AI Gateway
AI_GATEWAY_API_KEY=""
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
VISION_MODEL=deepseek/deepseek-v4.1-flash-1017
EMBEDDING_MODEL=google/gemini-embedding-2

# Scenario and admin seed commands
SEED_RANDOM_SEED=clemora-scenario-v1
# SEED_CLOCK=2026-11-16T00:00:00Z
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
