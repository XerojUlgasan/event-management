# Environment settings, parsing, and defaults live in src/env.ts.
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="event_management"
DB_USER="event_management"
DB_PASSWORD="event_management"
API_PORT=3000
WEB_ORIGIN="http://localhost:4321"
SESSION_TTL_DAYS=7

# Firebase Admin credentials (Firebase console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or point at the downloaded service-account JSON instead of the three values above.
# Place the file in apps/api/.secrets/ (gitignored) and use a path relative to apps/api:
# GOOGLE_APPLICATION_CREDENTIALS=".secrets/firebase-service-account.json"

# Catalog media in the private Supabase Storage bucket event-management.
# Object keys use pending/ and owner folders (see README catalog media).
# The edge runtime injects the URL and
# service role; set them here for the Node API. Do not commit real keys.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="event-management"

# Optional Storage bucket (defaults to event-management).
# SUPABASE_STORAGE_BUCKET=event-management
# Edge also accepts SUPABASE_SECRET_KEY or SUPABASE_SECRET_KEYS.

# Private ES256 signing JWK (including kid) imported into this Supabase project.
# REALTIME_JWT_SIGNING_JWK=
# Local Supabase only. Set to the local stack's legacy JWT secret.
# REALTIME_JWT_SECRET=

# Optional Firebase credential sources; enable only the source you use.
# GOOGLE_APPLICATION_CREDENTIALS=../../.secrets/firebase-service-account.json
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional runtime/seed/admin command settings.
# NODE_ENV=production
# SEED_CLOCK=2026-11-16T00:00:00Z
# SEED_RANDOM_SEED=clemora-scenario-v1
# ADMIN_EMAIL=
# ADMIN_PASSWORD=


AI_GATEWAY_API_KEY=

VISION_MODEL=deepseek/deepseek-v4.1-flash-1017
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
DECISION_MODEL=typesafe-ai/jev-1.14.0
EMBEDDING_MODEL=google/gemini-embedding-2

