# Raw environment settings are mapped in src/env.ts.
SUPABASE_DB_URL="postgresql://event_management:event_management@localhost:5432/event_management"
API_PORT=3000
WEB_ORIGIN="http://localhost:4321"
SESSION_TTL_DAYS=7

# Local Compose and disposable test database setup.
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="event_management"
DB_USER="event_management"
DB_PASSWORD="event_management"

# Used by pnpm prod:supabase:deploy. Use the hosted direct or session pooler URL.
# SUPABASE_ACCESS_TOKEN=
# PROD_SUPABASE_DB_URL=
# PROD_SUPABASE_REF=

# Firebase Admin credentials (Firebase console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or point at the downloaded service-account JSON instead of the three values above.
# Place the file in apps/api/.secrets/ (gitignored) and use a path relative to apps/api:
# GOOGLE_APPLICATION_CREDENTIALS=".secrets/firebase-service-account.json"

# Private Cloudflare R2 buckets for media and supporting PDFs.
# Keep credentials in the server environment.
# S3_API_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=event-management
# R2_SUPPORTING_DOCUMENTS_BUCKET_NAME=supporting-documents
# Optional stable prefix for isolated environments sharing an R2 bucket.
# R2_OBJECT_PREFIX=test-rooms/catalog/<unique-id>

# Server-only HS256 JWT secret trusted by this Supabase Realtime project (at least 32 bytes).
# SUP_JWT_KEY=

# Optional Firebase credential sources; enable only the source you use.
# GOOGLE_APPLICATION_CREDENTIALS=../../.secrets/firebase-service-account.json
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional runtime/seed/admin command settings.
# NODE_ENV=production
# SEED_CLOCK=2026-11-16T00:00:00Z
# SEED_RANDOM_SEED=clemora-scenario-v1
# ADMIN_EMAIL=
# ADMIN_PASSWORD=


AI_GATEWAY_API_KEY=

VISION_MODEL=deepseek/deepseek-v4.1-flash-1017
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
DECISION_MODEL=typesafe-ai/jev-1.14.0
EMBEDDING_MODEL=google/gemini-embedding-2

