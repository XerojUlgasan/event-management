{
  "name": "@event-management/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "kysely-codegen --out-file src/db/types.ts --exclude-pattern _prisma_migrations",
    "db:check": "tsx src/db/check.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "dotenv": "^18.0.8",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
