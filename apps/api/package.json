{
  "name": "@event-management/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "build:edge": "tsx scripts/build-edge.ts",
    "check": "tsc --noEmit",
    "test:auth": "firebase emulators:exec --only auth --project demo-event-management --config tests/firebase.json \"tsx --test tests/auth.test.ts\"",
    "test:password": "tsx --test tests/password.test.ts",
    "test:edge": "tsx --test tests/edge-routes.test.ts tests/edge-auth.test.ts",
    "test:rls": "tsx --test tests/rls-migration.test.ts",
    "start": "tsx src/index.ts",
    "db:up": "docker compose --env-file .env -f compose.yaml up -d db",
    "db:down": "docker compose --env-file .env -f compose.yaml down",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset -f && pnpm db:migrate && pnpm db:seed",
    "db:generate": "tsx src/db/generate.ts",
    "db:check": "tsx src/db/check.ts",
    "media:cleanup": "tsx src/db/cleanup-catalog-media.ts",
    "catalog:embed": "tsx src/db/embed-catalog.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts",
    "test:packages": "tsx --test tests/packages.test.ts tests/canvas-jsonb-migration.test.ts tests/service-pricing-migration.test.ts tests/catalog-canvas-validation.test.ts tests/canvas-validation-migration.test.ts tests/thumbnail-migration.test.ts tests/package-services-removal-migration.test.ts tests/catalog-sample-photos-migration.test.ts",
    "test:quotations": "tsx --test tests/quotations.test.ts tests/quotation-acceptance-removal-migration.test.ts",
    "test:proposal-migration": "tsx --test tests/proposal-migration.test.ts",
    "test:catalog-knowledge": "tsx --test tests/catalog-knowledge-migration.test.ts tests/knowledge-index-http.test.ts tests/ai/prepare-catalog-knowledge.test.ts tests/ai/embed-catalog-content.test.ts tests/ai/catalog-embedding-images.test.ts tests/ai/catalog-embeddings.test.ts tests/ai/catalog-knowledge-dashboard.test.ts tests/ai/catalog-knowledge-search.test.ts tests/ai/catalog-media-relocation.test.ts",
    "test:guest-chat": "tsx --test tests/guest-chat.test.ts",
    "test:messages": "tsx --test tests/messages.test.ts tests/chat-images.test.ts tests/image-message-jobs-migration.test.ts tests/conversation-activity-migration.test.ts",
    "test:booking-requests": "tsx --test tests/booking-requests.test.ts",
    "test:event-days": "tsx --test tests/event-days.test.ts",
    "test:catalog-staff-removal": "tsx --test tests/catalog-staff-removal-migration.test.ts",
    "test:checklist-removal": "tsx --test tests/checklist-removal-migration.test.ts",
    "worker:background-jobs": "tsx src/workers/background-jobs.ts",
    "test:background-jobs": "tsx --test tests/background-jobs.test.ts tests/background-jobs-worker.test.ts"
  },
  "dependencies": {
    "@event-management/contracts": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "ai": "^7.0.173",
    "dotenv": "^18.0.8",
    "firebase-admin": "^14.5.0",
    "hash-wasm": "4.13.0",
    "hono": "^4.13.13",
    "imagescript": "3.20.3",
    "jose": "6.2.18",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "kysely-codegen": "^0.20.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
