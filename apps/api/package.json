{
  "name": "@event-management/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test:auth": "firebase emulators:exec --only auth --project demo-event-management --config tests/firebase.json \"tsx --test tests/auth.test.ts\"",
    "start": "tsx src/index.ts",
    "db:up": "docker compose --env-file .env -f compose.yaml up -d db",
    "db:down": "docker compose --env-file .env -f compose.yaml down",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset -f && pnpm db:migrate && pnpm db:seed",
    "db:generate": "tsx src/db/generate.ts",
    "db:check": "tsx src/db/check.ts",
    "media:cleanup": "tsx src/db/cleanup-catalog-media.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts",
    "test:packages": "tsx --test tests/packages.test.ts",
    "test:messages": "tsx --test tests/messages.test.ts",
    "test:booking-requests": "tsx --test tests/booking-requests.test.ts",
    "test:quotations": "tsx --test tests/quotations.test.ts",
    "test:venues": "tsx --test tests/venues.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@event-management/contracts": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.8",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
