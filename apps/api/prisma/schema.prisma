datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String?   @unique @map("firebase_uid")
  passwordHash String?   @map("password_hash")
  email        String    @unique
  displayName  String?   @map("display_name")
  role         String    @default("customer")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingRequests BookingRequest[]
  bookingStatusChanges BookingRequestStatusHistory[]
  sessions     Session[]
  conversations Conversation[] @relation("CustomerConversations")
  sentMessages Message[]     @relation("MessageSender")
  mediaAssets MediaAsset[]
  quotations Quotation[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Conversation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  status          String    @default("active")
  aiEnabled       Boolean   @default(true) @map("ai_enabled")
  aiVersion       Int       @default(0) @map("ai_version")
  aiHandoff       Json?     @map("ai_handoff") @db.JsonB
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  bookingRequestId String?  @unique @map("booking_request_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        User?     @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  bookingRequest  BookingRequest? @relation("BookingRequestConversation", fields: [bookingRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  guestIdentityId String? @map("guest_identity_id") @db.Uuid
  guestIdentity GuestChatIdentity? @relation("GuestOwner", fields: [guestIdentityId], references: [id], onDelete: Restrict)
  claimedGuestIdentityId String? @map("claimed_guest_identity_id") @db.Uuid
  claimedGuestIdentity GuestChatIdentity? @relation("GuestClaim", fields: [claimedGuestIdentityId], references: [id], onDelete: Restrict)
  guestExpiresAt DateTime? @map("guest_expires_at") @db.Timestamptz(6)
  guestCustomerMessageCount Int @default(0) @map("guest_customer_message_count")
  guestRequests GuestMessageRequest[]
  messages        Message[]

  @@index([claimedGuestIdentityId], map: "conversations_claimed_guest_identity_idx")
  @@index([status])
  @@index([customerId, createdAt])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String?      @map("sender_id") @db.Uuid
  senderRole     String       @default("customer") @map("sender_role")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  guestOrigin Boolean @default(false) @map("guest_origin")
  quotationId    String?      @unique @map("quotation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  quotation      Quotation?   @relation(fields: [quotationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  images MessageImage[]
  replyToMessageId String? @unique @map("reply_to_message_id") @db.Uuid
  replyToMessage Message? @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reply Message? @relation("MessageReply")
  aiToolCallsAsCustomerMessage AiToolCall[] @relation("AiToolCallCustomerMessage")
  aiToolCallsAsAssistantMessage AiToolCall[] @relation("AiToolCallAssistantMessage")
  aiToolCallsAsSourceMessage AiToolCall[] @relation("AiToolCallSourceMessage")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageImage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  position Int
  storageKey String @unique @map("storage_key")
  mimeType String @map("mime_type")
  byteSize Int @map("byte_size")
  contentHash String @map("content_hash")
  interpretation Json? @db.JsonB
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@map("message_images")
}

model AiToolCall {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId             String    @map("turn_id") @db.Uuid
  toolCallId         String    @map("tool_call_id")
  toolName           String    @map("tool_name")
  customerMessageId  String?   @map("customer_message_id") @db.Uuid
  assistantMessageId String?   @map("assistant_message_id") @db.Uuid
  sourceMessageId    String?   @map("source_message_id") @db.Uuid
  status             String    @default("started")
  input              Json      @db.JsonB
  output             Json?     @db.JsonB
  errorCode          String?   @map("error_code")
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  customerMessage  Message? @relation("AiToolCallCustomerMessage", fields: [customerMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assistantMessage Message? @relation("AiToolCallAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourceMessage Message? @relation("AiToolCallSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([turnId, toolCallId], map: "ai_tool_calls_turn_id_tool_call_id_key")
  @@index([customerMessageId], map: "ai_tool_calls_customer_message_id_idx")
  @@index([assistantMessageId], map: "ai_tool_calls_assistant_message_id_idx")
  @@index([sourceMessageId], map: "ai_tool_calls_source_message_id_idx")
  @@map("ai_tool_calls")
}

// State checks, pending-job deduplication, and RLS live in SQL.
model BackgroundJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  payload        Json      @default("{}") @db.JsonB
  dedupeKey      String?   @map("dedupe_key")
  status         String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken     String?   @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("background_jobs")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Package {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)
  name            String
  slug            String            @unique
  description     String            @default("")
  maxGuests       Int               @map("max_guests")
  price           Int
  publishedAt     DateTime?         @default(now()) @map("published_at") @db.Timestamptz(6)
  packageType     String            @default("catalog") @map("package_type")
  customForBookingRequestId String? @unique @map("custom_for_booking_request_id") @db.Uuid
  customForBookingRequest BookingRequest? @relation("CustomBookingPackage", fields: [customForBookingRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bookingRequests BookingRequest[] @relation("InquiryPackage")
  knowledge CatalogKnowledge[]
  canvas          Json              @default("[]") @db.JsonB
  thumbnailMediaId String?          @map("thumbnail_media_id") @db.Uuid
  thumbnailMedia MediaAsset? @relation("PackageThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([canvas(ops: JsonbPathOps)], type: Gin, map: "packages_canvas_idx")
  @@map("packages")
}


model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  name String
  slug String @unique
  description String
  hourlyRatePesos Int? @map("hourly_rate_pesos")
  fixedPricePesos Int? @map("fixed_price_pesos")
  includedHours Int? @map("included_hours")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  canvas Json @default("[]") @db.JsonB
  thumbnailMediaId String? @map("thumbnail_media_id") @db.Uuid
  thumbnailMedia MediaAsset? @relation("ServiceThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  knowledge CatalogKnowledge[]
  @@index([canvas(ops: JsonbPathOps)], type: Gin, map: "services_canvas_idx")
  @@map("services")
}

model MediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind String
  source String
  url String?
  storageKey String? @unique @map("storage_key")
  mimeType String? @map("mime_type")
  byteSize Int? @map("byte_size")
  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  thumbnailPackages Package[] @relation("PackageThumbnail")
  thumbnailServices Service[] @relation("ServiceThumbnail")
  knowledge CatalogKnowledge[]
  @@map("media_assets")
}

model CatalogKnowledge {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId       String?                 @map("package_id") @db.Uuid
  serviceId       String?                 @map("service_id") @db.Uuid
  chunkKey        String                  @map("chunk_key")
  contentMarkdown String                  @map("content_markdown")
  mediaId         String?                 @map("media_id") @db.Uuid
  contentHash     String                  @map("content_hash")
  embedding       Unsupported("vector(768)")?
  embeddingModel  String?                 @map("embedding_model")
  embeddedAt      DateTime?               @map("embedded_at") @db.Timestamptz(6)
  package         Package?                @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service         Service?                @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media           MediaAsset?             @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([packageId, chunkKey])
  @@unique([serviceId, chunkKey])
  @@index([mediaId])
  @@map("catalog_knowledge")
}

model Quotation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  version Int
  currency String @default("PHP")
  baseAmountMinor Int @map("base_amount_minor")
  totalAmountMinor Int @map("total_amount_minor")
  items Json @default("[]") @db.JsonB
  status String @default("draft")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  offeredPackageId String @map("offered_package_id") @db.Uuid
  adjustmentsReviewed Boolean @default(true) @map("adjustments_reviewed")
  previousQuotationId String? @map("previous_quotation_id") @db.Uuid
  revisionReason String? @map("revision_reason")
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previousQuotation Quotation? @relation("QuotationRevision", fields: [previousQuotationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions Quotation[] @relation("QuotationRevision")
  message Message?

  @@unique([bookingRequestId, version])
  @@index([bookingRequestId, status])
  @@index([createdBy])
  @@index([previousQuotationId])
  @@map("quotations")
}

model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String
  entityType String @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  metadata Json @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("audit_events")
}

model BookingRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference String @unique
  customerId String @map("customer_id") @db.Uuid
  packageId String? @map("package_id") @db.Uuid
  eventType String @map("event_type")
  preferredDate String @map("preferred_date")
  requestedDays Json? @map("requested_days") @db.JsonB
  estimatedDuration String @default("undecided") @map("estimated_duration")
  estimatedDurationDays Int? @map("estimated_duration_days")
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(6)
  timeZone String @map("time_zone")
  guestCount Int? @map("guest_count")
  contactName String @map("contact_name")
  phoneNumber String @map("phone_number")
  preferredVenueLocation String? @map("preferred_venue_location")
  specialRequests String? @map("special_requests")
  status String @default("under_review")
  outOfRange Boolean @map("out_of_range")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  package Package? @relation("InquiryPackage", fields: [packageId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customPackage Package? @relation("CustomBookingPackage")
  quotations Quotation[]
  history BookingRequestStatusHistory[]
  conversation Conversation? @relation("BookingRequestConversation")
  eventDays EventDay[]
  @@index([customerId, createdAt])
  @@map("booking_requests")
}

model BookingRequestStatusHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  status String
  reason String?
  changedBy String @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor User @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([bookingRequestId, createdAt])
  @@map("booking_request_status_history")
}

// Status checks and RLS live in SQL.
model EventDay {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  day DateTime @db.Date
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  status String @default("scheduled")
  replacementEventDayId String? @map("replacement_event_day_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacementEventDay EventDay? @relation("EventDayReplacement", fields: [replacementEventDayId, bookingRequestId], references: [id, bookingRequestId], onDelete: Restrict, onUpdate: NoAction, map: "events_day_replacement_same_booking_fkey")
  replacedEventDays EventDay[] @relation("EventDayReplacement")

  @@unique([id, bookingRequestId])
  @@index([bookingRequestId, day])
  @@index([replacementEventDayId, bookingRequestId])
  @@map("events_day")
}

model GuestChatIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  conversations Conversation[] @relation("GuestOwner")
  claimedConversations Conversation[] @relation("GuestClaim")
  @@map("guest_chat_identities")
}

model GuestMessageRequest {
  conversationId String @map("conversation_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  messageId String @unique @map("message_id") @db.Uuid
  assistantMessageId String? @map("assistant_message_id") @db.Uuid
  assistantError String? @map("assistant_error")
  completed Boolean @default(false)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@id([conversationId, requestId])
  @@map("guest_message_requests")
}
