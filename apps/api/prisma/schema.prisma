datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String?   @unique @map("firebase_uid")
  passwordHash String?   @map("password_hash")
  email        String    @unique
  displayName  String?   @map("display_name")
  role         String    @default("customer")
  staffRole    String?   @map("staff_role")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingRequests BookingRequest[]
  bookingStatusChanges BookingRequestStatusHistory[]
  sessions     Session[]
  conversations Conversation[] @relation("CustomerConversations")
  sentMessages Message[]     @relation("MessageSender")

  @@map("users")
}

model Conversation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  packageId       String?   @map("package_id") @db.Uuid
  eventType       String?   @map("event_type")
  eventStartsAt   DateTime? @map("event_starts_at") @db.Timestamptz(6)
  eventEndsAt     DateTime? @map("event_ends_at") @db.Timestamptz(6)
  guestCount      Int?      @map("guest_count")
  status          String    @default("active")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  bookingRequestId String?  @unique @map("booking_request_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        User      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  bookingRequest  BookingRequest? @relation("BookingRequestConversation", fields: [bookingRequestId], references: [id], onDelete: SetNull)
  package         Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([status])
  @@index([customerId, createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String?      @map("sender_id") @db.Uuid
  senderRole     String       @default("customer") @map("sender_role")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Package {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)
  bookingRequests BookingRequest[]
  versions        PackageVersion[]
  conversations   Conversation[]

  @@map("packages")
}

model PackageImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("package_images")
}

model Venue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  versions VenueVersion[]
  @@map("venues")
}

model VenueVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId String @map("venue_id") @db.Uuid
  version Int
  state String
  name String
  location String
  description String
  categories String[]
  capacityMin Int? @map("capacity_min")
  capacityMax Int? @map("capacity_max")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  photos VenueVersionPhoto[]
  @@unique([venueId, version])
  @@map("venue_versions")
}

model VenueImage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType String @map("content_type")
  data Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  photos VenueVersionPhoto[]
  @@map("venue_images")
}

model VenueVersionPhoto {
  venueVersionId String @map("venue_version_id") @db.Uuid
  imageId String @map("image_id") @db.Uuid
  position Int
  version VenueVersion @relation(fields: [venueVersionId], references: [id], onDelete: Cascade)
  image VenueImage @relation(fields: [imageId], references: [id], onDelete: Restrict)
  @@id([venueVersionId, imageId])
  @@unique([venueVersionId, position])
  @@map("venue_version_photos")
}

model PackageVersion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId    String    @map("package_id") @db.Uuid
  version      Int
  state        String
  name         String
  eventTypes   String[]  @map("event_types")
  description  String
  guestMin     Int       @map("guest_min")
  guestMax     Int       @map("guest_max")
  venueDetails String    @map("venue_details")
  inclusions   String[]
  exclusions   String[]
  terms        String
  imageUrl     String?   @map("image_url")
  priceAmountMinor Int?  @map("price_amount_minor")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  package      Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookingRequests BookingRequest[]
  services     PackageService[]

  @@unique([packageId, version])
  @@map("package_versions")
}

model ServiceImage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType String @map("content_type")
  data Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("service_images")
}

model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  versions ServiceVersion[]
  @@map("services")
}

model ServiceVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  version Int
  state String
  name String
  description String
  categories String[]
  imageUrl String? @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageServices PackageService[]
  @@unique([serviceId, version])
  @@map("service_versions")
}

model PackageService {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageVersionId String @map("package_version_id") @db.Uuid
  serviceVersionId String @map("service_version_id") @db.Uuid
  role String
  includedQuantity Int? @map("included_quantity")
  addOnUnitPriceAmountMinor Int? @map("add_on_unit_price_amount_minor")
  addOnMaxQuantity Int? @map("add_on_max_quantity")
  packageVersion PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  serviceVersion ServiceVersion @relation(fields: [serviceVersionId], references: [id], onDelete: Restrict)
  @@unique([packageVersionId, serviceVersionId])
  @@map("package_services")
}

model BookingRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference String @unique
  customerId String @map("customer_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid
  packageVersionId String @map("package_version_id") @db.Uuid
  packageName String @map("package_name")
  eventType String @map("event_type")
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  timeZone String @map("time_zone")
  guestCount Int @map("guest_count")
  contactName String @map("contact_name")
  phoneNumber String @map("phone_number")
  preferredVenueLocation String @map("preferred_venue_location")
  specialRequests String? @map("special_requests")
  status String @default("under_review")
  outOfRange Boolean @map("out_of_range")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageVersion PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  history BookingRequestStatusHistory[]
  conversation Conversation? @relation("BookingRequestConversation")
  @@index([customerId, createdAt])
  @@map("booking_requests")
}

model BookingRequestStatusHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  status String
  reason String?
  changedBy String @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  @@index([bookingRequestId, createdAt])
  @@map("booking_request_status_history")
}
