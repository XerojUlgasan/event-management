datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String?   @unique @map("firebase_uid")
  passwordHash String?   @map("password_hash")
  email        String    @unique
  displayName  String?   @map("display_name")
  role         String    @default("customer")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingRequests BookingRequest[]
  bookingStatusChanges BookingRequestStatusHistory[]
  sessions     Session[]
  conversations Conversation[] @relation("CustomerConversations")
  sentMessages Message[]     @relation("MessageSender")
  mediaAssets MediaAsset[]
  quotations Quotation[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Conversation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  status          String    @default("active")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  bookingRequestId String?  @unique @map("booking_request_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        User      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  bookingRequest  BookingRequest? @relation("BookingRequestConversation", fields: [bookingRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  messages        Message[]

  @@index([status])
  @@index([customerId, createdAt])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String?      @map("sender_id") @db.Uuid
  senderRole     String       @default("customer") @map("sender_role")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  quotationId    String?      @unique @map("quotation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  quotation      Quotation?   @relation(fields: [quotationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Package {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)
  name            String
  slug            String            @unique
  description     String            @default("")
  maxGuests       Int               @map("max_guests")
  price           Int
  publishedAt     DateTime?         @default(now()) @map("published_at") @db.Timestamptz(6)
  packageType     String            @default("catalog") @map("package_type")
  customForBookingRequestId String? @unique @map("custom_for_booking_request_id") @db.Uuid
  customForBookingRequest BookingRequest? @relation("CustomBookingPackage", fields: [customForBookingRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bookingRequests BookingRequest[] @relation("InquiryPackage")
  services PackageService[]
  page            CatalogPage?

  @@map("packages")
}


model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  name String
  slug String @unique
  description String
  hourlyRatePesos Int? @map("hourly_rate_pesos")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  page CatalogPage?
  packages PackageService[]
  @@map("services")
}

model CatalogPage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId String? @unique @map("package_id") @db.Uuid
  serviceId String? @unique @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sections CatalogSection[]
  @@map("catalog_pages")
}

model CatalogSection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId String @map("page_id") @db.Uuid
  title String @default("")
  sortOrder Int @map("sort_order")
  page CatalogPage @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  widgets CatalogWidget[]
  @@unique([pageId, sortOrder])
  @@map("catalog_sections")
}

model CatalogWidget {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  type String
  sortOrder Int @map("sort_order")
  x Int
  y Int
  w Int
  h Int
  markdown String @default("")
  mediaId String? @map("media_id") @db.Uuid
  alt String @default("")
  caption String @default("")
  autoplay Boolean @default(false)
  section CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([sectionId, sortOrder])
  @@index([mediaId])
  @@map("catalog_widgets")
}

model MediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind String
  source String
  url String?
  storageKey String? @unique @map("storage_key")
  mimeType String? @map("mime_type")
  byteSize Int? @map("byte_size")
  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  widgets CatalogWidget[]
  @@map("media_assets")
}

model PackageService {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId String @map("package_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  role String
  sortOrder Int @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([packageId, serviceId])
  @@unique([packageId, sortOrder])
  @@index([serviceId])
  @@map("package_services")
}

model Quotation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  version Int
  currency String @default("PHP")
  baseAmountMinor Int @map("base_amount_minor")
  totalAmountMinor Int @map("total_amount_minor")
  items Json @default("[]") @db.JsonB
  status String @default("draft")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  offeredPackageId String @map("offered_package_id") @db.Uuid
  adjustmentsReviewed Boolean @default(true) @map("adjustments_reviewed")
  previousQuotationId String? @map("previous_quotation_id") @db.Uuid
  revisionReason String? @map("revision_reason")
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previousQuotation Quotation? @relation("QuotationRevision", fields: [previousQuotationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions Quotation[] @relation("QuotationRevision")
  message Message?

  @@unique([bookingRequestId, version])
  @@index([bookingRequestId, status])
  @@index([createdBy])
  @@index([previousQuotationId])
  @@map("quotations")
}

model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String
  entityType String @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  metadata Json @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("audit_events")
}

model BookingRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference String @unique
  customerId String @map("customer_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid
  eventType String @map("event_type")
  preferredDate String @map("preferred_date")
  requestedDays Json? @map("requested_days") @db.JsonB
  estimatedDuration String @default("undecided") @map("estimated_duration")
  estimatedDurationDays Int? @map("estimated_duration_days")
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(6)
  timeZone String @map("time_zone")
  guestCount Int? @map("guest_count")
  contactName String @map("contact_name")
  phoneNumber String @map("phone_number")
  preferredVenueLocation String? @map("preferred_venue_location")
  specialRequests String? @map("special_requests")
  status String @default("under_review")
  outOfRange Boolean @map("out_of_range")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  package Package @relation("InquiryPackage", fields: [packageId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customPackage Package? @relation("CustomBookingPackage")
  quotations Quotation[]
  history BookingRequestStatusHistory[]
  conversation Conversation? @relation("BookingRequestConversation")
  eventDays EventDay[]
  @@index([customerId, createdAt])
  @@map("booking_requests")
}

model BookingRequestStatusHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  status String
  reason String?
  changedBy String @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor User @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([bookingRequestId, createdAt])
  @@map("booking_request_status_history")
}

// Status checks and RLS live in SQL.
model EventDay {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String @map("booking_request_id") @db.Uuid
  day DateTime @db.Date
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  status String @default("scheduled")
  replacementEventDayId String? @map("replacement_event_day_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacementEventDay EventDay? @relation("EventDayReplacement", fields: [replacementEventDayId, bookingRequestId], references: [id, bookingRequestId], onDelete: Restrict, onUpdate: NoAction, map: "events_day_replacement_same_booking_fkey")
  replacedEventDays EventDay[] @relation("EventDayReplacement")

  @@unique([id, bookingRequestId])
  @@index([bookingRequestId, day])
  @@index([replacementEventDayId, bookingRequestId])
  @@map("events_day")
}
