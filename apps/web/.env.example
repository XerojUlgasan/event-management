# Public and server configuration lives in src/env.ts.
# pnpm all uses this Node API URL. pnpm dev sets PUBLIC_API_URL=/v1 and proxies that path to the local Supabase gateway.
PUBLIC_API_URL="http://localhost:3000/v1"
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# Optional Supabase gateway for server proxying. pnpm dev supplies this in the shell.
# Astro config reads shell variables before Astro loads .env files.
# API_PROXY_TARGET=http://127.0.0.1:54321
