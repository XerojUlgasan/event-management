---
import PublicDocument from "./PublicDocument.astro";

interface Props {
  title: string;
  description: string;
  catalog: "packages" | "services";
}

const { title, description, catalog } = Astro.props;
const navLabel = catalog === "packages" ? "Package catalog" : "Service catalog";
---

<PublicDocument title={title} description={description}>
  <div class="public-catalog-detail">
    <div class="public-catalog-detail-shell">
      <nav class="section-back" aria-label={navLabel}>
        <a href={`/${catalog}`}>All {catalog}</a>
      </nav>
      <slot />
    </div>
  </div>
</PublicDocument>
