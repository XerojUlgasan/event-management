---
import PublicDocument from "./PublicDocument.astro";
import { CatalogDetailSurface } from "../components/catalog/CatalogDetailSurface";

interface Props {
  title: string;
  description: string;
  catalog: "packages" | "services";
}

const { title, description, catalog } = Astro.props;
---

<PublicDocument title={title} description={description}>
  <CatalogDetailSurface catalog={catalog}>
    <slot />
  </CatalogDetailSurface>
</PublicDocument>
