---
import "../styles/app.css";
import "../styles/catalog/public-catalog.css";
import "../styles/showcases/public.css";
import { Brand, Icon } from "@event-management/ui";
import { BusinessInformationFooter } from "../components/public/site/BusinessInformationFooter";
import { loadBusinessInformation } from "../lib/server/business-information/load-business-information";
import type { BusinessInformation } from "@event-management/contracts/business-information";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

Astro.response.headers.set("Cache-Control", "no-store");

let businessInformation: BusinessInformation | null = null;

try {
  businessInformation = (await loadBusinessInformation()).information;
} catch {
  // Optional footer details must not prevent visitors from browsing the catalog.
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script>
      // Public catalog cards are server-rendered, so React handlers do not run.
      const hideFailedThumbnail = (image: HTMLImageElement) => {
        if (image.matches("[data-catalog-thumbnail-image]"))
          image.hidden = true;
      };

      document.addEventListener(
        "error",
        (event) => {
          if (event.target instanceof HTMLImageElement)
            hideFailedThumbnail(event.target);
        },
        true,
      );
      document
        .querySelectorAll<HTMLImageElement>("[data-catalog-thumbnail-image]")
        .forEach((image) => {
          if (image.complete && image.naturalWidth === 0)
            hideFailedThumbnail(image);
        });
    </script>
  </head>
  <body>
    <div class="public-site">
      <header class="public-header">
        <a href="/" aria-label="Styled by AMAC home">
          <Brand />
        </a>
        <nav class="public-nav" aria-label="Primary">
          <a href="/packages">Packages</a>
          <a href="/services">Services</a>
          <a href="/showcases">Showcases</a>
        </nav>
        <div class="header-actions">
          <a class="button button-link" href="/login">
            Sign in
          </a>
          <details class="public-mobile-nav">
            <summary aria-label="Open navigation">
              <Icon name="menu" />
            </summary>
            <nav aria-label="Mobile navigation">
              <a href="/packages">Packages</a>
              <a href="/services">Services</a>
              <a href="/showcases">Showcases</a>
            </nav>
          </details>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <BusinessInformationFooter information={businessInformation} />
    </div>
  </body>
</html>
