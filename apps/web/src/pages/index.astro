---
import PublicDocument from "../layouts/PublicDocument.astro";
import {
  PackageCards,
  ServiceCards,
} from "../components/public/catalog/CatalogCards";
import { ActionLink, Toast } from "@event-management/ui";
import { loadPackages, loadServices } from "../lib/server/catalog/load-catalog";
import type { PublicPackage } from "../lib/data/catalog/packages";
import type { PublicService } from "../lib/data/catalog/services";

let packages: PublicPackage[] = [];
let services: PublicService[] = [];
let unavailable = false;
try {
  [packages, services] = await Promise.all([loadPackages(3), loadServices(3)]);
} catch {
  unavailable = true;
}
const description =
  "Styled by AMAC connects event planning, customer bookings, and catering operations in one workspace.";
---

<PublicDocument
  title="Styled by AMAC | Event management"
  description={description}
>
  <section class="amac-hero" aria-labelledby="hero-title">
    <div class="amac-hero-copy">
      <h1 id="hero-title">
        Creating the
        <br />
        best <em>day ever.</em>
      </h1>
      <p>
        Plan celebrations, team gatherings, and milestone occasions with clear
        packages, shared updates, and seamless coordination.
      </p>
      <div class="amac-hero-actions">
        <a class="button button-primary" href="/packages">
          Explore packages <span aria-hidden="true">↗</span>
        </a>
        <a class="amac-text-link" href="/about">
          Meet Styled by AMAC
        </a>
      </div>
    </div>
    <figure class="amac-hero-photo">
      <img
        src="/images/hero.jpg"
        alt="An intimate event setting with softly lit dinner tables"
        width="1200"
        height="1500"
        fetchpriority="high"
      />
      <figcaption>A setting for your next celebration.</figcaption>
    </figure>
  </section>

  <section class="packages section" id="packages">
    <div class="section-heading">
      <div>
        <h2 class="section-title small">A thoughtful place to begin</h2>
      </div>
      <p>
        Every package can be tailored to your menu, setting, guest count, and
        service needs.
      </p>
    </div>
    {unavailable && (
      <Toast tone="danger" placement="inline">
        <span>The catalog is unavailable right now.</span>
        <a href={Astro.url.pathname}>Try again</a>
      </Toast>
    )}
    {!unavailable && packages.length === 0 && (
      <p class="catalog-status">No packages are published yet.</p>
    )}
    {packages.length > 0 && <PackageCards items={packages} />}
    <a class="button button-secondary catalog-view-more" href="/packages">
      View more packages <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section
    class="public-services section"
    id="services"
    aria-labelledby="services-title"
  >
    <div class="section-heading">
      <div>
        <h2 class="section-title small" id="services-title">
          Explore our services
        </h2>
      </div>
      <p>
        Discover services for your celebration and discuss the details with our
        team.
      </p>
    </div>
    {!unavailable && services.length === 0 && (
      <p class="catalog-status">
        Our service catalog is being prepared. Please check back soon.
      </p>
    )}
    {services.length > 0 && <ServiceCards items={services} />}
    <a class="button button-secondary catalog-view-more" href="/services">
      View more services <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="intro section" id="intro">
    <div>
      <h2 class="section-title">
        More than a checklist.
        <br />
        One place for every event detail.
      </h2>
    </div>
    <div class="intro-copy">
      <p>
        Styled by AMAC connects package discovery, booking requests, schedules,
        planning updates, and event progress in one simple experience.
      </p>
      <ActionLink href="/about">How Styled by AMAC works</ActionLink>
    </div>
  </section>

  <section class="cta section">
    <div>
      <h2 class="section-title">Your table is waiting.</h2>
    </div>
    <a class="button button-light" href="/about">
      Tell us about your event <span aria-hidden="true">→</span>
    </a>
  </section>
</PublicDocument>
