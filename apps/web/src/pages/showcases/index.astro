---
import PublicDocument from "../../layouts/PublicDocument.astro";
import { ShowcaseExpanded } from "../../components/public/showcase/ShowcaseExpanded";
import { Pagination, Toast } from "@event-management/ui";
import {
  loadShowcasesPage,
  showcasePageLinks,
} from "../../lib/server/catalog/load-showcases";
import type { ShowcaseRecord } from "@event-management/contracts/showcase";

const q = Astro.url.searchParams;
let showcases: ShowcaseRecord[] = [];
let nextCursor: string | null = null;
let unavailable = false;
try {
  const page = await loadShowcasesPage(undefined, q.get("cursor") ?? undefined);
  showcases = page.showcases;
  nextCursor = page.nextCursor;
} catch {
  unavailable = true;
}

const links = showcasePageLinks(Astro.url, nextCursor);
---

<PublicDocument
  title="Showcases | Styled by AMAC"
  description="Past events styled by AMAC — photographs, videos, and the details behind each celebration."
>
  <section class="section showcase-page">
    <div class="section-heading">
      <div>
        <h1 class="section-title small">All showcases</h1>
      </div>
      <p>Browse past events we've styled.</p>
    </div>

    {unavailable && (
      <Toast tone="danger" placement="inline">
        <span>Showcases unavailable right now.</span>
        <a href={Astro.url.pathname}>Try again</a>
      </Toast>
    )}

    {!unavailable && showcases.length === 0 && (
      <p class="catalog-status">
        No showcases published yet. Check back soon.
      </p>
    )}

    {showcases.length > 0 && (
      <div class="showcase-list">
        {showcases.map((item) => (
          <ShowcaseExpanded item={item} client:load />
        ))}
      </div>
    )}

    {(links.previous || links.next) && (
      <Pagination
        page={q.getAll("previous").length + 1}
        hasNextPage={!!links.next}
        previousHref={links.previous ?? undefined}
        nextHref={links.next ?? undefined}
        label="Showcase pages"
      />
    )}
  </section>
</PublicDocument>
