---
import PublicDocument from "../../layouts/PublicDocument.astro";
import { ShowcaseListing } from "../../components/public/site/ShowcaseListing";
import { Toast } from "@event-management/ui";
import { SHOWCASE_LIST_PAGE_SIZE } from "@event-management/contracts/limits/showcase";
import { loadShowcasesPage } from "../../lib/server/catalog/load-showcases";
import type { ShowcasePage } from "../../lib/data/showcases/showcases";

let page: ShowcasePage | null = null;

try {
  page = await loadShowcasesPage(
    SHOWCASE_LIST_PAGE_SIZE,
    Astro.url.searchParams.get("cursor") ?? undefined,
  );
} catch {}
---

<PublicDocument
  title="Showcases | Styled by AMAC"
  description="Past events styled by AMAC — photographs, videos, and the details behind each celebration."
>
  <section class="section showcase-page">
    <div class="section-heading">
      <div>
        <h1 class="section-title small">All showcases</h1>
      </div>
      <p>Browse past events we've styled.</p>
    </div>

    {page ? (
      <ShowcaseListing
        initialPage={page}
        initialUrl={Astro.url.href}
        client:load
      />
    ) : (
      <Toast tone="danger" placement="inline">
        <span>Showcases unavailable right now.</span>
        <a href={Astro.url.pathname}>Try again</a>
      </Toast>
    )}
  </section>
</PublicDocument>
