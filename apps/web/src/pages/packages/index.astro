---
import { Pagination, Toast } from "@event-management/ui";
import PublicDocument from "../../layouts/PublicDocument.astro";
import { PackageCards } from "../../components/public/catalog/CatalogCards";
import {
  catalogPageLinks,
  loadPackagesPage,
} from "../../lib/server/catalog/load-catalog";
import { EVENT_TYPES } from "@event-management/contracts/catalog-filters";
import type { PublicPackage } from "../../lib/data/catalog/packages";
import type { CatalogFilters } from "@event-management/contracts/catalog-filters";

const q = Astro.url.searchParams;
const filters: CatalogFilters = {
  eventType: EVENT_TYPES.includes(q.get("eventType") as any)
    ? (q.get("eventType") as CatalogFilters["eventType"])
    : undefined,
  guests: q.get("guests") ? Number(q.get("guests")) : undefined,
  minPricePesos: q.get("minPricePesos") ? Number(q.get("minPricePesos")) : undefined,
  maxPricePesos: q.get("maxPricePesos") ? Number(q.get("maxPricePesos")) : undefined,
};

let packages: PublicPackage[] = [];
let unavailable = false;
let nextCursor: string | null = null;
try {
  const page = await loadPackagesPage(
    filters,
    undefined,
    q.get("cursor") ?? undefined,
  );
  packages = page.items;
  nextCursor = page.nextCursor;
} catch {
  unavailable = true;
}

const links = catalogPageLinks(Astro.url, nextCursor, filters);
const hasFilters = Object.values(filters).some((v) => v !== undefined);
---

<PublicDocument
  title="Packages | Styled by AMAC"
  description="Published event packages from Styled by AMAC."
>
  <section class="section">
    <h1 class="section-title small">All packages</h1>
    <p>Explore packages for your gathering.</p>

    <form method="get" action="/packages" class="catalog-filter-bar">
      <label>
        Event type
        <select name="eventType" onchange="this.form.submit()">
          <option value="">All types</option>
          {EVENT_TYPES.map((type) => (
            <option value={type} selected={filters.eventType === type}>
              {type}
            </option>
          ))}
        </select>
      </label>
      <label>
        Min price (₱)
        <input
          type="number"
          name="minPricePesos"
          min="0"
          step="1"
          value={filters.minPricePesos ?? ""}
          placeholder="Any"
        />
      </label>
      <label>
        Max price (₱)
        <input
          type="number"
          name="maxPricePesos"
          min="0"
          step="1"
          value={filters.maxPricePesos ?? ""}
          placeholder="Any"
        />
      </label>
      <label>
        Guests
        <input
          type="number"
          name="guests"
          min="1"
          step="1"
          value={filters.guests ?? ""}
          placeholder="Any"
        />
      </label>
      <button type="submit" class="button button-secondary">Filter</button>
      {hasFilters && (
        <a href="/packages" class="button button-secondary">Clear</a>
      )}
    </form>

    {unavailable && (
      <Toast tone="danger" placement="inline">
        <span>The catalog is unavailable right now.</span>
        <a href={Astro.url.pathname}>Try again</a>
      </Toast>
    )}
    {!unavailable && packages.length === 0 && (
      <p class="catalog-status">
        {hasFilters
          ? "No packages match your filters. Try adjusting them or clear to see all packages."
          : "No packages are published yet."}
      </p>
    )}
    {packages.length > 0 && <PackageCards items={packages} />}
    {!unavailable && (
      <Pagination
        page={q.getAll("previous").length + 1}
        hasNextPage={!!links.next}
        previousHref={links.previous ?? undefined}
        nextHref={links.next ?? undefined}
        label="Catalog pages"
      />
    )}
  </section>
</PublicDocument>
