---
import { Toast } from "@event-management/ui";
import PublicCatalogDetailLayout from "../../layouts/PublicCatalogDetailLayout.astro";
import { PublicPackageBooking } from "../../components/public/catalog/PublicPackageBooking";
import { PublicPackageDetail } from "../../components/public/catalog/PublicPackageDetail";
import type { PublicPackage } from "../../lib/data/catalog/packages";
import { loadPackage } from "../../lib/server/catalog/load-catalog";

const slug = Astro.params.slug ?? "";

const catalogId = Astro.url.searchParams.get("catalogId") ?? undefined;

let item: PublicPackage | null = null;
let unavailable = false;

try {
  item = await loadPackage(slug, catalogId);
} catch {
  unavailable = true;
}

if (!unavailable && !item) Astro.response.status = 404;

if (catalogId && item)
  return Astro.redirect(`/packages/${encodeURIComponent(item.slug)}`);

const title = item
  ? `${item.name} | Styled by AMAC`
  : "Package not found | Styled by AMAC";

const description = item?.description || "This package is not available.";
---

<PublicCatalogDetailLayout
  title={title}
  description={description}
  catalog="packages"
>
  {unavailable && (
    <Toast tone="danger" placement="inline">
      <span>The catalog is unavailable right now.</span>
      <a href={`${Astro.url.pathname}${Astro.url.search}`}>Try again</a>
    </Toast>
  )}
  {!unavailable && !item && (
    <p class="catalog-status">This package is not available.</p>
  )}
  {item && (
    <PublicPackageDetail item={item}>
      <PublicPackageBooking item={item} client:load />
    </PublicPackageDetail>
  )}
</PublicCatalogDetailLayout>
