---
import { Pagination, Toast } from "@event-management/ui";
import PublicDocument from "../../layouts/PublicDocument.astro";
import { VenueCards } from "../../components/public/catalog/CatalogCards";
import {
  catalogPageLinks,
  loadVenuesPage,
} from "../../lib/server/catalog/load-catalog";
import type { Venue } from "../../lib/data/catalog/venues";

let venues: Venue[] = [];
let unavailable = false;
let nextCursor: string | null = null;
try {
  const page = await loadVenuesPage(
    undefined,
    Astro.url.searchParams.get("cursor") ?? undefined,
  );
  venues = page.items;
  nextCursor = page.nextCursor;
} catch {
  unavailable = true;
}
const links = catalogPageLinks(Astro.url, nextCursor);
---

<PublicDocument
  title="Venues | Clemora"
  description="Published venues from Clemora."
>
  <section class="section">
    <span class="eyebrow">Find your setting</span>
    <h1 class="section-title small">All venues</h1>
    <p>
      Explore venues for your gathering. Availability is confirmed by our team
      when reviewing your request.
    </p>
    {unavailable && (
      <Toast tone="danger" placement="inline">
        <span>The catalog is unavailable right now.</span>
        <a href={Astro.url.pathname}>Try again</a>
      </Toast>
    )}
    {!unavailable && venues.length === 0 && (
      <p class="catalog-status">No venues are available yet.</p>
    )}
    {venues.length > 0 && <VenueCards items={venues} />}
    {!unavailable && (
      <Pagination
        page={Astro.url.searchParams.getAll("previous").length + 1}
        hasNextPage={!!links.next}
        previousHref={links.previous ?? undefined}
        nextHref={links.next ?? undefined}
        label="Catalog pages"
      />
    )}
  </section>
</PublicDocument>
