---
import { Toast } from "@event-management/ui";
import PublicDocument from "../../layouts/PublicDocument.astro";
import { PublicVenueDetail } from "../../components/public/catalog/PublicCatalogDetail";
import type { Venue } from "../../lib/data/catalog/venues";
import { loadVenue } from "../../lib/server/catalog/load-catalog";

const slug = Astro.params.slug ?? "";
let item: Venue | null = null;
let unavailable = false;
try {
  item = await loadVenue(slug);
} catch {
  unavailable = true;
}
if (!unavailable && !item) Astro.response.status = 404;
const title = item ? `${item.name} | Clemora` : "Venue not found | Clemora";
const description = item?.description || "This venue is not available.";
---

<PublicDocument title={title} description={description}>
  <p class="section-back">
    <a href="/venues">All venues</a>
  </p>
  {unavailable && (
    <Toast tone="danger" placement="inline">
      <span>The catalog is unavailable right now.</span>
      <a href={Astro.url.pathname}>Try again</a>
    </Toast>
  )}
  {!unavailable && !item && (
    <p class="catalog-status">This venue is not available.</p>
  )}
  {item && <PublicVenueDetail item={item} />}
</PublicDocument>
