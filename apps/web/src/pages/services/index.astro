---
import { Toast } from "@event-management/ui"
import PublicDocument from "../../layouts/PublicDocument.astro"
import { ServiceCards } from "../../components/public/CatalogCards"
import { loadServices } from "../../lib/server/catalog"
import type { PublicService } from "../../lib/data/services"

let services: PublicService[] = []
let unavailable = false
try {
  services = await loadServices()
} catch {
  unavailable = true
}
---

<PublicDocument title="Services | Clemora" description="Published event services from Clemora.">
  <section class="section">
    <span class="eyebrow">Make it yours</span>
    <h1 class="section-title small">All services</h1>
    <p>Explore services for your gathering.</p>
    {unavailable && <Toast tone="danger" placement="inline"><span>The catalog is unavailable right now.</span><a href={Astro.url.pathname}>Try again</a></Toast>}
    {!unavailable && services.length === 0 && <p class="catalog-status">Our service catalog is being prepared. Please check back soon.</p>}
    {services.length > 0 && <ServiceCards items={services} />}
  </section>
</PublicDocument>
