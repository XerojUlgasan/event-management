---
import { Pagination, Toast } from "@event-management/ui";
import PublicDocument from "../../layouts/PublicDocument.astro";
import { ServiceCards } from "../../components/public/catalog/CatalogCards";
import {
  catalogPageLinks,
  loadServicesPage,
} from "../../lib/server/catalog/load-catalog";
import { EVENT_TYPES } from "@event-management/contracts/catalog-filters";
import type { PublicService } from "../../lib/data/catalog/services";
import type { CatalogFilters } from "@event-management/contracts/catalog-filters";

const q = Astro.url.searchParams;
const pricingType = q.get("pricingType");
const filters: CatalogFilters = {
  eventType: EVENT_TYPES.includes(q.get("eventType") as any)
    ? (q.get("eventType") as CatalogFilters["eventType"])
    : undefined,
  pricingType:
    pricingType === "fixed" || pricingType === "hourly"
      ? pricingType
      : undefined,
  minPricePesos: q.get("minPricePesos") ? Number(q.get("minPricePesos")) : undefined,
  maxPricePesos: q.get("maxPricePesos") ? Number(q.get("maxPricePesos")) : undefined,
};

let services: PublicService[] = [];
let unavailable = false;
let nextCursor: string | null = null;
try {
  const page = await loadServicesPage(
    filters,
    undefined,
    q.get("cursor") ?? undefined,
  );
  services = page.items;
  nextCursor = page.nextCursor;
} catch {
  unavailable = true;
}

const links = catalogPageLinks(Astro.url, nextCursor, filters);
const hasFilters = Object.values(filters).some((v) => v !== undefined);
---

<PublicDocument
  title="Services | Styled by AMAC"
  description="Published event services from Styled by AMAC."
>
  <section class="section">
    <h1 class="section-title small">All services</h1>
    <p>Explore services for your gathering.</p>

    <form method="get" action="/services" class="catalog-filter-bar">
      <label>
        Event type
        <select name="eventType" onchange="this.form.submit()">
          <option value="">All types</option>
          {EVENT_TYPES.map((type) => (
            <option value={type} selected={filters.eventType === type}>
              {type}
            </option>
          ))}
        </select>
      </label>
      <label>
        Pricing
        <select name="pricingType" onchange="this.form.submit()">
          <option value="">Any</option>
          <option value="fixed" selected={filters.pricingType === "fixed"}>Fixed price</option>
          <option value="hourly" selected={filters.pricingType === "hourly"}>Hourly</option>
        </select>
      </label>
      <button type="submit" class="button button-secondary">Filter</button>
      {hasFilters && (
        <a href="/services" class="button button-secondary">Clear</a>
      )}
    </form>

    {unavailable && (
      <Toast tone="danger" placement="inline">
        <span>The catalog is unavailable right now.</span>
        <a href={Astro.url.pathname}>Try again</a>
      </Toast>
    )}
    {!unavailable && services.length === 0 && (
      <p class="catalog-status">
        {hasFilters
          ? "No services match your filters. Try adjusting them or clear to see all services."
          : "Our service catalog is being prepared. Please check back soon."}
      </p>
    )}
    {services.length > 0 && <ServiceCards items={services} />}
    {!unavailable && (
      <Pagination
        page={q.getAll("previous").length + 1}
        hasNextPage={!!links.next}
        previousHref={links.previous ?? undefined}
        nextHref={links.next ?? undefined}
        label="Catalog pages"
      />
    )}
  </section>
</PublicDocument>
