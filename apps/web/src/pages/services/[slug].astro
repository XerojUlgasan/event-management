---
import { Toast } from "@event-management/ui";
import PublicDocument from "../../layouts/PublicDocument.astro";
import { PublicServiceDetail } from "../../components/public/catalog/PublicCatalogDetail";
import type { PublicService } from "../../lib/data/catalog/services";
import { loadService } from "../../lib/server/catalog/load-catalog";

const slug = Astro.params.slug ?? "";
let item: PublicService | null = null;
let unavailable = false;
try {
  item = await loadService(slug);
} catch {
  unavailable = true;
}
if (!unavailable && !item) Astro.response.status = 404;
const title = item ? `${item.name} | Clemora` : "Service not found | Clemora";
const description = item?.description || "This service is not available.";
---

<PublicDocument title={title} description={description}>
  <p class="section-back">
    <a href="/services">All services</a>
  </p>
  {unavailable && (
    <Toast tone="danger" placement="inline">
      <span>The catalog is unavailable right now.</span>
      <a href={Astro.url.pathname}>Try again</a>
    </Toast>
  )}
  {!unavailable && !item && (
    <p class="catalog-status">This service is not available.</p>
  )}
  {item && <PublicServiceDetail item={item} />}
</PublicDocument>
